# ElevenLabs API Key — set via `elevenlabs auth login` (stored under ~/.agents/),
# this file is mostly informational. The CLI reads from its auth store, not env.
ELEVENLABS_API_KEY=your_api_key_here

# Backend URL (publicly reachable — typically an ngrok tunnel for local dev).
# Used by the agents-push Makefile target to substitute YOUR_BACKEND in tool
# configs before pushing.
#   Example: BACKEND_URL=https://abc123.ngrok.app
BACKEND_URL=
