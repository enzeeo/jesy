# Backend env. Copy to .env (gitignored) and fill in.

# Required for /intake/voice and /demo/trigger-call to use real LLM extraction.
# If unset, /intake/voice returns 503 and /demo/trigger-call uses stub data.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: ElevenLabs webhook signature verification.
# If unset, /intake/voice accepts unsigned requests (dev mode warning logged).
ELEVENLABS_WEBHOOK_SECRET=

# Optional: Snowflake. If any are unset, writer is no-op and tile queries
# fall back to in-memory computation. Demo works without these.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=DISASTER_WH
SNOWFLAKE_DATABASE=DISASTER_DB
SNOWFLAKE_SCHEMA=OPERATIONAL
