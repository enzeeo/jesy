# =============================================================
# Disaster Relief — Environment template
# Copy to `.env` (never commit) and fill in real values.
# =============================================================

# --------- API server (services/api) ---------
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --------- Snowflake (services/api) ---------
SF_ACCOUNT=xy12345.us-west-2
SF_USER=disaster_app_user
SF_ROLE=DISASTER_APP_ROLE
SF_WAREHOUSE=COMPUTE_WH
SF_DATABASE=DISASTER_RELIEF
SF_SCHEMA=PUBLIC
# Use key-pair auth: generate with `openssl genrsa 2048 | openssl pkcs8 -topk8 ...`
# Then `ALTER USER disaster_app_user SET RSA_PUBLIC_KEY='...';`
SF_PRIVATE_KEY_PATH=./.snowflake/rsa_key.p8
# Optional passphrase if key is encrypted
SF_PRIVATE_KEY_PASS=

# --------- Mapbox (apps/responder + services/api) ---------
# Public token — used by the responder frontend with referrer restriction.
# Set restriction at https://account.mapbox.com/access-tokens/ for localhost:5174.
VITE_MAPBOX_PUBLIC_TOKEN=pk.eyJ1...
# Server-side token for Optimization API (can be the same restricted token).
MAPBOX_SERVER_TOKEN=pk.eyJ1...

# --------- API URL exposed to frontends ---------
VITE_API_BASE_URL=http://localhost:8787

# --------- ElevenLabs (stretch / nice-to-have) ---------
# Leave blank for v1. Fill when wiring Conversational AI.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --------- TensorMesh (stretch / nice-to-have) ---------
TENSORMESH_API_KEY=

# --------- Cloudflare Tunnel (only for ElevenLabs webhook) ---------
# Run: cloudflared tunnel --url http://localhost:8787
# The printed tunnel URL goes into the ElevenLabs agent webhook config.

# --------- Demo admin shortcut ---------
ADMIN_TOKEN=hackathon-demo-token

# --------- Snowflake key file storage path (gitignored) ---------
# Place your rsa_key.p8 file in .snowflake/ and chmod 600.
