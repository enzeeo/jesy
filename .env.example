# Backend env. Copy to .env (gitignored) and fill in.

# Required for /intake/voice and /demo/trigger-call to use real LLM extraction.
# If unset, /intake/voice returns 503 and /demo/trigger-call uses stub data.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: ElevenLabs webhook signature verification.
# If unset, /intake/voice accepts unsigned requests (dev mode warning logged).
ELEVENLABS_WEBHOOK_SECRET=

# Optional: Snowflake. If any are unset, writer is no-op and tile queries
# fall back to in-memory computation. Demo works without these.
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_user
SNOWFLAKE_ROLE=TRAINING_ROLE
SNOWFLAKE_WAREHOUSE=JEZY_WH
SNOWFLAKE_DATABASE=DISASTER_DB
SNOWFLAKE_SCHEMA=CLEAN

# Pick ONE auth method:

# Key-pair auth — run `uv run python scripts/snowflake_keypair_setup.py` to generate.
SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Password or programmatic access token (PAT) — paste PAT here for learner accounts.
SNOWFLAKE_PASSWORD=

NEXT_PUBLIC_BACKEND_URL=https://indicatively-perissodactylous-mable.ngrok-free.dev
NEXT_PUBLIC_DEFAULT_LOCATION_LAT=19.7257
NEXT_PUBLIC_DEFAULT_LOCATION_LNG=-155.0834
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_6301krszvy6temz9c53w9d7eaf1z